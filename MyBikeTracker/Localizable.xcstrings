    "nfc_action_stop_ride_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks you to confirm finishing the current ride. Does nothing if no ride is active."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает подтвердить завершение текущей поездки. Ничего не делает, если поездки нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонує підтвердити завершення поточної поїздки. Нічого не робить, якщо поїздки немає."
          }
        }
      }
    },
