    "privacy_section_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rides stay on this device. Optional Mapbox matching sends coordinates over HTTPS only when a token is configured."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездки хранятся на этом устройстве. Опциональный Mapbox matching отправляет координаты по HTTPS только если задан токен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поїздки зберігаються на цьому пристрої. Необов’язковий Mapbox matching надсилає координати через HTTPS лише якщо задано токен."
          }
        }
      }
    },
    "privacy_policy_title": {
      "extractionState": "manual",
