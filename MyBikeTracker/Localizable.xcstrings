    "developer_section_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug only. Simulates a moving ride in the simulator. Stop on the Trip tab saves it to History without writing to Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только Debug. Эмулирует поездку в симуляторе. Стоп на вкладке «Поездка» сохраняет её в Историю, без записи в Apple Health."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише Debug. Емулює поїздку в симуляторі. Стоп на вкладці «Поїздка» зберігає її в Історію, без запису в Apple Health."
          }
        }
      }
    },
