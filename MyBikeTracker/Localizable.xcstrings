    "nfc_section_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a tag once, then hold an unlocked iPhone near it. The first tap starts a ride; the next tap asks you to finish it. iOS may show a notification — open it to launch the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите метку один раз, затем поднесите разблокированный iPhone. Первое касание запускает поездку, следующее предлагает её завершить. iOS может показать уведомление — откройте его, чтобы запустить приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть мітку один раз, потім піднесіть розблокований iPhone. Перший дотик запускає поїздку, наступний пропонує її завершити. iOS може показати сповіщення — відкрийте його, щоб запустити програму."
          }
        }
      }
    },
