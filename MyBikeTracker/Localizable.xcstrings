    "export_privacy_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup includes precise ride tracks, bikes, and journal notes. Share it only with people you trust."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В резервной копии будут точные треки поездок, велосипеды и записи журнала. Делитесь только с теми, кому доверяете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У резервній копії будуть точні треки поїздок, велосипеди та записи журналу. Діліться лише з тими, кому довіряєте."
          }
        }
