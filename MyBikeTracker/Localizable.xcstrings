    "ride_line_color_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This color applies only to this ride. Other rides keep the default map color from Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот цвет применяется только к этой поездке. Остальные линии используют цвет из настроек."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей колір застосовується лише до цієї поїздки. Інші лінії використовують колір з налаштувань."
          }
        }
      }
    },
    "ride_line_color_reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use default color"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать цвет по умолчанию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати колір за замовчуванням"
          }
        }
      }
    },
    "route_color_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live ride line is colored by speed — teal is slow, ember is fast. The color below tints the rider marker. Finished rides use the same speed colors on the Map tab unless you pick a custom color — tap the line on Map or open the ride in History."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия активной поездки окрашивается по скорости: бирюзовый — медленно, оранжевый — быстро. Цвет ниже задаёт маркер райдера. Завершённые поездки на вкладке «Карта» тоже красятся по скорости, пока вы не зададите свой цвет линии — нажатием на линию или в истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лінія активної поїздки забарвлюється за швидкістю: бірюзовий — повільно, помаранчевий — швидко. Колір нижче задає маркер райдера. Завершені поїздки на вкладці «Карта» також фарбуються за швидкістю, доки ви не задасте свій колір лінії — натисканням на лінію або в історії."
          }
        }
      }
    },
