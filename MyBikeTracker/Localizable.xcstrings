    },
    "privacy_policy_open_web": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open online copy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть онлайн-копию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити онлайн-копію"
          }
        }
      }
    },
    "privacy_policy_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trail Dawn (MyBikeTracker) is a local bike tracker. Ride history, bikes, and journal entries are stored on your device with SwiftData."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Trail Dawn (MyBikeTracker) — локальный велотрекер. История поездок, велосипеды и журнал хранятся на устройстве в SwiftData."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trail Dawn (MyBikeTracker) — локальний велотрекер. Історія поїздок, велосипеди та журнал зберігаються на пристрої в SwiftData."
          }
        }
      }
    },
    "privacy_policy_location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is requested as When In Use first. Always and background updates are used only while a ride is recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала запрашивается доступ «при использовании». Always и фоновые обновления включаются только во время записи поездки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку запитується доступ «під час використання». Always і фонові оновлення вмикаються лише під час запису поїздки."
          }
        }
      }
    },
    "privacy_policy_health": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Apple Health is enabled, the app writes cycling workouts, calories, optional heart rate, and the GPS route. It does not read Health data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включён Apple Health, приложение записывает велотренировки, калории, пульс (если есть) и GPS-маршрут. Данные Health не читаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено Apple Health, програма записує велотренування, калорії, пульс (якщо є) і GPS-маршрут. Дані Health не читаються."
          }
        }
      }
    },
    "privacy_policy_export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON export is a full backup: rides with GPS, bikes, and journal photos. You choose when to share it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON-экспорт — полная резервная копия: поездки с GPS, велосипеды и фото журнала. Вы сами решаете, с кем ею делиться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON-експорт — повна резервна копія: поїздки з GPS, велосипеди та фото журналу. Ви самі вирішуєте, з ким нею ділитися."
          }
        }
      }
    },
    "privacy_policy_analytics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics stay on device: product events and MetricKit crash summaries. Nothing is sent to a third-party analytics service."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика остаётся на устройстве: события продукта и сводки сбоев MetricKit. Ничего не отправляется в стороннюю аналитику."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діагностика лишається на пристрої: події продукту та зведення збоїв MetricKit. Нічого не надсилається в сторонню аналітику."
          }
        }
      }
    },
    "privacy_policy_third_party": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional Mapbox Map Matching and Apple MapKit Directions receive coordinates only to snap or draw a route. There are no ads and no account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опциональный Mapbox Map Matching и Apple MapKit Directions получают координаты только чтобы построить маршрут. Нет рекламы и аккаунта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язковий Mapbox Map Matching і Apple MapKit Directions отримують координати лише щоб побудувати маршрут. Немає реклами й облікового запису."
          }
        }
      }
    },
    "diagnostics_section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діагностика"
          }
        }
      }
    },
    "diagnostics_no_crashes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No crash reports on this device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве нет отчётов о сбоях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої немає звітів про збої."
          }
        }
      }
    },
    "diagnostics_events_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local event log and MetricKit help find ride-save and location issues. Data never leaves the phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный журнал событий и MetricKit помогают находить проблемы с сохранением поездок и геопозицией. Данные не покидают телефон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальний журнал подій і MetricKit допомагають знаходити проблеми зі збереженням поїздок і геопозицією. Дані не залишають телефон."
          }
        }
      }
    },
    "store_error_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ride library unavailable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека поездок недоступна"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бібліотека поїздок недоступна"
          }
        }
      }
    },
    "store_error_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device database could not be opened. Your existing files were backed up and were not deleted. This session is temporary until the store can be opened again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть локальную базу. Существующие файлы сохранены в резервную копию и не удалялись. Эта сессия временная, пока базу не удастся открыть снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити локальну базу. Наявні файли збережено в резервну копію і не видалялися. Ця сесія тимчасова, доки базу не вдасться відкрити знову."
          }
        }
      }
    },
    "store_backup_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Database recovered from backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База восстановлена из резервной копии"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу відновлено з резервної копії"
          }
        }
      }
    },
    "store_backup_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the ride library failed once. A backup was made and the store was opened without deleting your data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая попытка открыть библиотеку не удалась. Сделана резервная копия, база открыта без удаления данных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перша спроба відкрити бібліотеку не вдалася. Зроблено резервну копію, базу відкрито без видалення даних."
          }
        }
      }
