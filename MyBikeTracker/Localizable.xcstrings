    "nfc_action_toggle_ride_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a ride if none is active. If a ride is already running, shows a confirmation screen to finish it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает поездку, если она ещё не начата. Если поездка уже идёт — показывает экран подтверждения завершения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускає поїздку, якщо вона ще не почата. Якщо поїздка вже триває — показує екран підтвердження завершення."
          }
        }
      }
    },
    "nfc_action_start_ride": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start ride only"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только старт поездки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише старт поїздки"
          }
        }
      }
    },
    "nfc_action_start_ride_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a ride when you tap the tag. Does nothing if a ride is already active."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает поездку при поднесении метки. Ничего не делает, если поездка уже идёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускає поїздку при піднесенні мітки. Нічого не робить, якщо поїздка вже триває."
          }
        }
      }
    },
    "nfc_action_stop_ride": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish ride only"
